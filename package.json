    "[AUTHOR_URL]": "https://kicktemp.com",
    "[DATE]": "30.01.2026",
    "[PLUGINTYPE]": "system",
    "[STABILITY]": "beta"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "fast-xml-parser": "^5.3.4",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.0"
  }
